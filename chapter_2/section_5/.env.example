# Bedrockを使うリージョン（OpenAIのGPTモデルは us-east-1 などに限られる）
AWS_REGION=us-east-1
# AWSの認証情報は ~/.aws/credentials か環境変数（AWS_ACCESS_KEY_ID など）から読み込まれる
# Dockerで動かす場合はコンテナに渡すため、以下も設定する（aws configure export-credentials --format env で取得できる）
# AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
# AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>
# BedrockのAPIキーを使う場合のみ設定する（未設定ならAWSの認証情報から短期キーを自動生成する）
# AWS_BEARER_TOKEN_BEDROCK=<your_bedrock_api_key_here>
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
