# Load environment variables from .env file
dotenv

# LLM API Keys - Replace with your actual keys
export OPENAI_API_KEY="<your_openai_api_key_here>"
export GEMINI_API_KEY="<your_gemini_api_key_here>"

# Redis Configuration
export REDIS_HOST="localhost"
export REDIS_PORT="6379"
export REDIS_DB="0"

# Queue Processing Configuration (ratios must sum to 1.0)
export HIGH_PRIORITY_RATIO="0.7"
export MEDIUM_PRIORITY_RATIO="0.2"
export LOW_PRIORITY_RATIO="0.1"

# Task Configuration
export MAX_RETRY_ATTEMPTS="3"
export TASK_TIMEOUT_SECONDS="300"