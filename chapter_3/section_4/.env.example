# LLM Provider API Keys (managed centrally by the gateway)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Backend and Proxy URLs
BACKEND_URL=http://localhost:8000
PROXY_URL=http://localhost:8080

# Proxy Configuration (legacy, for backward compatibility)
PROXY_MAX_RETRIES=3
PROXY_RETRY_BACKOFF=2.0

# Gateway Configuration
# Security: Change this to a strong, random token in production
GATEWAY_API_TOKEN=dev-token-12345

# Retry and timeout settings
GATEWAY_MAX_RETRIES=3
GATEWAY_RETRY_BACKOFF=2.0
GATEWAY_TIMEOUT=30.0

# Cache settings
GATEWAY_ENABLE_CACHE=false
GATEWAY_CACHE_TTL=300